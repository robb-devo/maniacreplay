{
	"schemaVersion": 1,
	"id": "streamerreplay",
	"version": "${version}",
	"name": "ManiacReplay",
	"description": "Records every session automatically. Watch it again from any angle, fly smooth camera paths and export MP4 videos (also 9:16 for Shorts). Built for streamers: no setup, tiny overhead.",
	"authors": ["robb-devo"],
	"contact": {
		"sources": "https://github.com/robb-devo/maniacreplay",
		"issues": "https://github.com/robb-devo/maniacreplay/issues"
	},
	"license": "MIT",
	"icon": "assets/streamerreplay/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["dev.robb.streamerreplay.StreamerReplayClient"],
		"modmenu": ["dev.robb.streamerreplay.compat.ModMenuIntegration"]
	},
	"mixins": [
		{"config": "streamerreplay.client.mixins.json", "environment": "client"}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": ">=0.163.0"
	},
	"suggests": {
		"modmenu": "*"
	},
	"breaks": {
		"replaymod": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.github_releases": "https://github.com/robb-devo/maniacreplay/releases"
			}
		}
	}
}
